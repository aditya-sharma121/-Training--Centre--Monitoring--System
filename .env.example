# Database connection (SQLite for local dev, PostgreSQL for Neon/Supabase)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/tcms?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here"

# Feature Flags
NEXT_PUBLIC_APP_NAME="TCMS – Training Centre Monitoring System"
NEXT_PUBLIC_ENABLE_AI_FEATURES="true"

# GIS Map Defaults
NEXT_PUBLIC_MAP_DEFAULT_LAT="22.5937"
NEXT_PUBLIC_MAP_DEFAULT_LNG="78.9629"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM="5"
